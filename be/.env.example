PORT=3000
# DB_TYPE: 'postgres' (mặc định dùng PostgreSQL) hoặc 'sqljs' (chế độ fallback nếu chưa bật Docker PostgreSQL)
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=saigondrain
DB_SYNCHRONIZE=true
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Free Weather & Elevation API (Open-Meteo - No API Key required)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
DEFAULT_LAT=10.7769
DEFAULT_LNG=106.7009

# Optional OpenWeatherMap API
OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5
OPENWEATHER_API_KEY=

# Free Map, Routing & Geocoding APIs (No API Key required)
OSRM_BASE_URL=https://router.project-osrm.org
PHOTON_BASE_URL=https://photon.komoot.io
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

